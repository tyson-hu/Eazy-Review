# Expo-safe client placeholders only. Copy to `.env` for local work.
# Values below are intentionally invalid placeholders so env validation fails
# with a clear error until you paste real local public values from
# `supabase status` (API URL + publishable or legacy anon key).
# Never commit real credentials. Never add service-role, DB passwords,
# JWT secrets, or management tokens. See docs/SECURITY.md.

EXPO_PUBLIC_SUPABASE_URL=https://example-local.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_local_publishable_key
