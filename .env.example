# Local client and Auth callback placeholders. Copy to `.env` for local work.
# Values below are intentionally invalid placeholders so configuration fails
# clearly until you paste real local public values and your current Mac LAN IP.
# Never commit real credentials. Never add service-role, DB passwords,
# JWT secrets, or management tokens. See docs/SECURITY.md.

EXPO_PUBLIC_SUPABASE_URL=https://example-local.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_local_publishable_key
# Physical-device recovery emails must reach Auth on the Mac. Keep `/auth/v1`.
SUPABASE_AUTH_EXTERNAL_URL=http://replace-with-mac-lan-ip.invalid:54321/auth/v1
