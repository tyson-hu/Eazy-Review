{
  "name": "eazy-review",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "expo": "~57.0.8",
    "expo-constants": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.8",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.0",
    "react-native-reanimated": "4.5.0",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.0",
    "tailwindcss": "^3.4.19",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "generate:routes": "expo customize tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "skills:generate": "node scripts/generate-skill-wrappers.cjs",
    "test:skill-wrappers": "node --test scripts/generate-skill-wrappers.test.cjs",
    "check:skill-wrappers": "node scripts/generate-skill-wrappers.cjs --check && npm run test:skill-wrappers",
    "decisions:build": "node scripts/build-decision-index.cjs",
    "test:decisions": "node --test scripts/build-decision-index.test.cjs",
    "decisions:check": "node scripts/build-decision-index.cjs --check && npm run test:decisions",
    "check:secrets": "npm run test:secrets && node scripts/check-secrets.cjs",
    "test:secrets": "node --test scripts/check-secrets.test.cjs",
    "db:reset": "DO_NOT_TRACK=1 supabase db reset",
    "test:db:pgtap": "DO_NOT_TRACK=1 supabase test db --local",
    "test:db:concurrency": "node scripts/test-db-concurrency.cjs",
    "test:db": "npm run test:db:pgtap && npm run test:db:concurrency",
    "test:db:reset": "npm run db:reset && npm run test:db",
    "check": "npm run check:skill-wrappers && npm run decisions:check && npm run check:secrets && npm run generate:routes && npm run typecheck && npm run lint && npx expo-doctor && npx expo install --check"
  },
  "private": true
}
