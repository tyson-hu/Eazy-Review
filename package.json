{
  "name": "eazy-review",
  "main": "expo-router/entry",
  "version": "1.0.0",
  "dependencies": {
    "@react-native-community/netinfo": "^12.0.1",
    "@supabase/supabase-js": "^2.112.0",
    "@tanstack/react-query": "^5.101.4",
    "expo": "~57.0.9",
    "expo-constants": "~57.0.6",
    "expo-font": "~57.0.1",
    "expo-linking": "~57.0.4",
    "expo-router": "~57.0.9",
    "expo-secure-store": "~57.0.1",
    "expo-splash-screen": "~57.0.5",
    "expo-status-bar": "~57.0.1",
    "expo-symbols": "~57.0.1",
    "expo-web-browser": "~57.0.2",
    "nativewind": "^4.2.6",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-url-polyfill": "^4.0.0",
    "react-native-web": "~0.21.0",
    "react-native-worklets": "0.10.1"
  },
  "devDependencies": {
    "@react-native/jest-preset": "^0.86.2",
    "@testing-library/react-native": "^14.0.1",
    "@types/jest": "^29.5.14",
    "@types/react": "~19.2.2",
    "babel-preset-expo": "~57.0.0",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~57.0.1",
    "jest": "^29.7.0",
    "jest-expo": "~57.0.3",
    "react-test-renderer": "^19.2.3",
    "tailwindcss": "^3.4.19",
    "test-renderer": "^1.2.0",
    "typescript": "~6.0.3"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "generate:routes": "expo customize tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "expo lint",
    "test": "jest --watchman=false --forceExit",
    "types:generate": "node scripts/generate-database-types.cjs",
    "types:check": "node scripts/generate-database-types.cjs --check",
    "skills:generate": "node scripts/generate-skill-wrappers.cjs",
    "test:skill-wrappers": "node --test scripts/generate-skill-wrappers.test.cjs",
    "check:skill-wrappers": "node scripts/generate-skill-wrappers.cjs --check && npm run test:skill-wrappers",
    "test:agent-infra": "node --test scripts/check-agent-infrastructure.test.cjs",
    "check:agent-infra": "npm run test:agent-infra && node scripts/check-agent-infrastructure.cjs",
    "decisions:build": "node scripts/build-decision-index.cjs",
    "test:decisions": "node --test scripts/build-decision-index.test.cjs",
    "decisions:check": "node scripts/build-decision-index.cjs --check && npm run test:decisions",
    "check:secrets": "npm run test:secrets && node scripts/check-secrets.cjs",
    "test:secrets": "node --test scripts/check-secrets.test.cjs",
    "check:task13-seed-reapply": "node scripts/check-task13-seed-reapply.cjs",
    "db:reset": "DO_NOT_TRACK=1 supabase db reset",
    "test:db:pgtap": "DO_NOT_TRACK=1 supabase test db --local",
    "test:db:concurrency": "node scripts/test-db-concurrency.cjs",
    "test:db": "npm run test:db:pgtap && npm run test:db:concurrency",
    "test:db:reset": "npm run check:task13-seed-reapply && npm run db:reset && npm run test:db",
    "prepare:routes": "npm run generate:routes",
    "check:readonly": "npm run check:skill-wrappers && npm run decisions:check && npm run check:secrets && npm run check:agent-infra && npm run typecheck && npm run lint",
    "check:expo": "npm run prepare:routes && npm run check:readonly && npm test && npx expo-doctor && npx expo install --check",
    "check": "npm run check:expo"
  },
  "private": true,
  "packageManager": "npm@11.17.0",
  "devEngines": {
    "packageManager": {
      "name": "npm",
      "version": ">=11.16.0 <12",
      "onFail": "error"
    }
  },
  "allowScripts": {
    "fsevents@2.3.3": true,
    "unrs-resolver@1.12.2": true
  }
}
